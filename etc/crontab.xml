<?xml version="1.0"?>

<config
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">

    <group id="default">
        <job
            name="training_productqa_cron"
            instance="Training\ProductQa\Cron\QuestionCron"
            method="execute">

            <schedule>* * * * *</schedule>
        </job>

        <job
            name="training_productqa_digest"
            instance="Training\ProductQa\Cron\QuestionDigestCron"
            method="execute">

            <schedule>* * * * *</schedule>
        </job>
    </group>
</config>
