<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">

    <system>
        <section id="productqa" translate="label" sortOrder="900" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Product QA</label>
            <tab>general</tab>
            <resource>Training_ProductQa::config</resource>

            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

            </group>

            <group id="digest" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Email Digest</label>
                <field id="recipient_email" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Recipient Email</label>
                    <validate>validate-email</validate>
                </field>
            </group>
        </section>
    </system>
</config>
