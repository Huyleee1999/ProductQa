<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Training_ProductQa::config" title="Product QA Config" sortOrder="90"/>
                        </resource>
                    </resource>
                </resource>

                <resource id="Training_ProductQa::question" title="Product QA Questions">
                    <resource id="Training_ProductQa::question_save" title="Save Question" sortOrder="10"/>
                    <resource id="Training_ProductQa::question_delete" title="Delete Question" sortOrder="20"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
